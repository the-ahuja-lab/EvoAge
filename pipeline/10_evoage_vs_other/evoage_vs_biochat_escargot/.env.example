# ---------------------------------------------------------------------------
# Configuration for the EvoAge vs BioChatter vs Escargot benchmark.
#
# Copy to Biochatter/.env and fill in. Both baselines read this one file:
# BioChatter directly, Escargot's subclasses via DEEPSEEK_ENV.
#
#     cp .env.example Biochatter/.env
#
# NEVER commit the filled-in copy. It carries live credentials.
# ---------------------------------------------------------------------------

# ---- Shared language model backend (identical for both baselines) ----
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_MAX_TOKENS=

# ---- EvoAge Neo4j graph (read-only; the same instance for both baselines) ----
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=

# ---- MedGemma judge endpoint (defaults shown; override if serving elsewhere) ----
# MEDGEMMA_BASE_URL=http://localhost:30001/v1
# MEDGEMMA_API_KEY=EMPTY
# MEDGEMMA_MODEL=

# ---- AlzKB sanity-check instance (isolated; not the EvoAge graph) ----
# ALZKB_URI=bolt://localhost:7688
# ALZKB_USER=neo4j
# ALZKB_PASSWORD=
